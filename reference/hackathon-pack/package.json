{
  "name": "omi-ui-hackathon-pack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A fakeable Omi capability SDK and HTML prototype starter for UI hackathons.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
